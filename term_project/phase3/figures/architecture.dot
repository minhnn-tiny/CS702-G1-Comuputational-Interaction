digraph G {
  rankdir=LR; fontname="Helvetica"; fontsize=11; node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569"]; edge [fontname="Helvetica", fontsize=9, color="#475569"];
  subgraph cluster_ui { label="Browser  (React 19 + Tailwind, SVG with D3 scales)"; style="rounded"; color="#94a3b8";
    compose [label="Compose panel\nbroadcast / direct / new task"]; queue [label="Queue panel\nRun · Step · Drop · Stop\nedit or remove queued messages"]; history [label="Message history\ncards, flag, Edit & revert, Reset here"]; overview [label="Overview (C3)\nsession columns, fork markers,\n3 colour encodings, suspect markers"];
    ctx [label="Error context panel (E1)\nranked suspects, who-said-what chain,\npreceding tool calls, warnings,\nsuggested edit → pre-filled editor", fillcolor="#ffe4e6"];
  }
  subgraph cluster_be { label="Backend  (Python 3.12, FastAPI)"; style="rounded"; color="#94a3b8";
    api [label="HTTP API  /api/*\nstate · run · step · drop · send · edit\nqueue/edit · judge · session · log · recordings"];
    mgr [label="Session manager\nsessions & forks, checkpoints,\nedit-and-revert (burst replay,\nstate rewrite), queue editing"];
    rec [label="Recorder\n(AutoGen InterventionHandler)\ntimestamp + save_state()\nbefore every message"];
    judge [label="Judge (E1)\none Claude Opus pass over a session\n→ ≤5 suspects + reasons + edits", fillcolor="#ffe4e6"];
    study [label="Study log\nparticipant · condition\nJSON lines per event", fillcolor="#fef9c3"];
    llm [label="Model client\nAnthropic SDK → Claude Haiku\n(retries, error surfacing)"];
  }
  subgraph cluster_rt { label="AutoGen 0.7.5 SingleThreadedAgentRuntime"; style="rounded"; color="#94a3b8";
    q [label="message queue", shape=cylinder, fillcolor="#eef2ff"];
    orch [label="Magentic-One\nOrchestrator", fillcolor="#dbeafe"]; coder [label="Coder", fillcolor="#ffedd5"]; exe [label="Executor\n(local subprocess)", fillcolor="#dcfce7"]; ws [label="WebSearcher\ncorpus or Wikipedia tools", fillcolor="#fee2e2"];
  }
  {compose queue history overview ctx} -> api [label="poll 0.7 s / POST", dir=both];
  api -> mgr; api -> study [style=dashed]; mgr -> judge [label="session JSON"]; mgr -> rec [label="history,\ncheckpoints"]; mgr -> q [label="start/stop/process_next\npublish/send, load_state"];
  rec -> q [label="intercepts", dir=back];
  q -> orch; q -> coder; q -> exe; q -> ws;
  {orch coder ws} -> llm [style=dashed];
  ws -> web [style=dashed]; web [label="corpus.json (cached web)\nMediaWiki API (live Wikipedia)", shape=note, fillcolor="#fef9c3"];
  mgr -> store [style=dashed]; store [label="recordings/*.pkl\nhistory, checkpoints, sessions, suspects", shape=folder, fillcolor="#fef9c3"];
  study -> logs [style=dashed]; logs [label="logs/<participant>.jsonl", shape=folder, fillcolor="#fef9c3"];
}
